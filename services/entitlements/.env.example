# EntitlementService — Konfiguration (WP 6.2).
#
# Echte Werte gehoeren NIE ins Repo (AGENTS.md §10 Klasse 3). Diese Datei
# nennt nur Platzhalter; der Dienst startet ohne die Pflichtwerte gar nicht
# erst, statt mit einem stillen Default weiterzulaufen.

# --- Datenbank ---
DATABASE_URL=postgres://entitlements:entwicklung@localhost:55432/entitlements

# --- Identitaet ---
# ISSUER IST KONFIGURATION. Daran haengt Phase 7: Der Wechsel vom heutigen
# Anbieter auf den self-hosted IdP kostet genau diese zwei Zeilen, keine
# Zeile Code.
AUTH_JWKS_URL=https://<projekt>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<projekt>.supabase.co/auth/v1
AUTH_AUDIENCE=fintracker-entitlements

# --- Mollie (NL) ---
# Testmodus-Key beginnt mit test_. Der Schluessel existiert NUR hier,
# serverseitig — der Client der App kennt Mollie ueberhaupt nicht.
MOLLIE_API_KEY=test_<platzhalter>
MOLLIE_REDIRECT_URL=https://<app-host>/billing
MOLLIE_WEBHOOK_URL=https://<dienst-host>/v1/mollie/webhook

# --- Produkt ---
BILLING_AMOUNT=4.99
BILLING_CURRENCY=EUR
BILLING_DESCRIPTION=Fintracker Premium

PORT=8080
