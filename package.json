  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run src/security src/lib/__tests__/tier.security.test.ts src/services/__tests__/local-crypto.security.test.ts src/services/__tests__/transaction-storage-service.security.test.ts src/services/__tests__/csv-service.test.ts src/services/__tests__/receipt-parser-service.test.ts --testNamePattern='\\[SECURITY\\]'",
    "test:integrity": "vitest run src/services/__tests__/transaction-allocation-service.test.ts src/services/__tests__/transaction-storage-service.security.test.ts src/services/__tests__/csv-service.test.ts src/services/__tests__/receipt-parser-service.test.ts src/components/dashboard/__tests__/filter-utils.test.ts src/lib/__tests__/contract-derivation.test.ts src/services/__tests__/snapshot-sync-service.test.ts --testNamePattern='\\[INTEGRITY\\]'",
    "test:privacy": "vitest run src/services/__tests__/local-crypto.security.test.ts src/services/__tests__/local-data-boundary.security.test.ts src/services/__tests__/forecast-overrides-service.test.ts src/services/__tests__/snapshot-sync-service.test.ts src/pages/__tests__/BankCallbackPage.security.test.ts --testNamePattern='\\[PRIVACY\\]'",
    "test:mobile": "vitest run src/features/dashboard/presentation/mobile/__tests__/DashboardMobileStory.swipe.test.ts src/components/dashboard/__tests__/TransactionListMobile.mobile.test.tsx src/components/common/__tests__/GlossaryTerm.test.tsx --testNamePattern='\\[MOBILE\\]'",
    "security:secrets": "node scripts/security-check.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n-module-consts": "node scripts/check-i18n-module-consts.mjs",
    "check:test-structure": "node scripts/check-test-structure.mjs",
    "prepare": "git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks || true"
  },
